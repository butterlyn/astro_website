---
import Page from "../layouts/Page.astro";
import { site } from "../data/site";
---

<Page>
  <section class="hero page-width" aria-labelledby="hero-title">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot" aria-hidden="true"></span>
        {site.eyebrow}
      </p>
      <h1 id="hero-title">{site.heading}</h1>
      <p class="intro">{site.introduction}</p>
      <a class="button" href="#about">
        Explore the preview <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="artwork" aria-hidden="true">
      <div class="artwork-orbit"></div>
      <div class="artwork-circle"></div>
      <div class="artwork-stem"></div>
      <div class="artwork-note">
        <span>ROOM TO GROW</span>
        <span>↗</span>
      </div>
    </div>
  </section>
  <section id="about" class="about page-width" aria-labelledby="about-title">
    <div class="about-heading">
      <p class="eyebrow">Just the beginning</p>
      <h2 id="about-title">{site.about.heading}</h2>
      <p>{site.about.description}</p>
    </div>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
      {site.cards.map((card) => (
        <article class="preview-card">
          <span class="card-number" aria-hidden="true">
            {card.number}
          </span>
          <h3>{card.title}</h3>
          <p>{card.description}</p>
        </article>
      ))}
    </div>
  </section>
</Page>
