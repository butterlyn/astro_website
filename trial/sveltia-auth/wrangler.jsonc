{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "leer-sveltia-auth",
  "main": "vendor/index.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "vars": {
    "ALLOWED_DOMAINS": "leer-sveltia.butterlyn.workers.dev,localhost,127.0.0.1"
  },
  "observability": { "enabled": false }
}
