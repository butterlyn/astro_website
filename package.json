{
  "name": "astro-website",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "check:setup": "node scripts/verify-skills.mjs && node --test tests/setup/*.test.mjs",
    "preflight:cloudflare": "node scripts/cloudflare-preflight.mjs",
    "dev": "node scripts/site.mjs dev production",
    "check": "node scripts/site.mjs check production",
    "check:pipeline": "node --test tests/pipeline/*.test.ts tests/pipeline/*.test.mjs",
    "lint": "biome lint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm build:production",
    "preview:cloudflare": "wrangler dev --config wrangler.production.jsonc --local --ip 127.0.0.1 --port 8787 --show-interactive-dev-session=false",
    "test:e2e": "playwright test",
    "dev:tina": "node scripts/site.mjs dev editing local",
    "tina:schema": "node scripts/site.mjs schema editing local",
    "check:editing": "node scripts/site.mjs check editing local",
    "test:feasibility": "node scripts/test-tina.mjs",
    "build:production": "node scripts/site.mjs build production",
    "build:editing:local": "node scripts/site.mjs build editing local",
    "build:editing": "node --env-file=.env scripts/site.mjs build editing cloud",
    "types:worker": "node scripts/types-worker.mjs",
    "test:editing": "playwright test --config playwright.editing.config.ts"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/cloudflare": "14.3.1",
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.13",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@tinacms/astro": "0.7.0",
    "@tinacms/cli": "2.7.0",
    "@types/node": "24.13.4",
    "astro": "7.3.2",
    "esbuild": "0.28.2",
    "jose": "6.2.12",
    "lighthouse": "13.4.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "1.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.3.3",
    "tinacms": "3.13.0",
    "typescript": "6.0.3",
    "wrangler": "4.131.1"
  }
}
